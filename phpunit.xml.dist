<?xml version="1.0" encoding="UTF-8"?>
<!-- OJO: el bootstrap unitario carga el nucleo REAL. El de integracion
     (tests/bootstrap.php) sustituye Logger y Utils por dobles, y con ellos las
     pruebas unitarias median un comportamiento que no existe: daba verde en local
     por casualidad y rojo en el CI. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" bootstrap="tests/bootstrap-unit.php" backupGlobals="false" colors="true" cacheResult="false" cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
    <testsuite name="integration">
      <directory suffix="Test.php">./tests/Integration</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory suffix="Test.php">./includes</directory>
    </include>
  </source>
</phpunit>
